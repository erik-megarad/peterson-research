def progressCell (p : Proc) (s : State) : Nat :=
  (progressRows p s.p0 >>> (9 * localIndex s.p1)) % 512

def progressRank (p : Proc) (s : State) : Nat := progressCell p s / 2

def progressActor (p : Proc) (s : State) : Proc := progressCell p s % 2 == 1

/-- Rank cannot increase before entry/abort. On a plateau the witness actor
stays fixed, is owed scheduling/completion, and each of its actions lowers rank. -/
def checkProgressState (p : Proc) (s : State) : Bool :=
  !(invariantB s && pendingPC (s.local p).pc) ||
    (owedPC (s.local (progressActor p s)).pc && allCommands.all fun c =>
      match next s c with
      | none => true
      | some t => outcome s c p ||
        (pendingPC (t.local p).pc &&
         decide (progressRank p t ≤ progressRank p s) &&
         (progressRank p t != progressRank p s || progressActor p t == progressActor p s) &&
         (!acts c (progressActor p s) || decide (progressRank p t < progressRank p s))))

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem progress_certificate_checked :
    [false, true].all (fun p => allLocals.all (fun a =>
      allLocals.all (fun b => checkProgressState p ⟨a, b⟩))) = true := by decide +kernel

